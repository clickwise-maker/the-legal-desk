DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legalflow"
# Supabase PostgreSQL — replace with your Supabase project connection string when ready
# Supabase project: oaxvbtnjnfhldgbidaot
# Pooled (Supavisor, port 6543, for serverless) and Direct (port 5432, for migrations) — see Supabase Dashboard > Database > Connection string
# Example pooled: "postgresql://postgres.oaxvbtnjnfhldgbidaot:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Example direct: "postgresql://postgres:[YOUR-PASSWORD]@db.oaxvbtnjnfhldgbidaot.supabase.co:5432/postgres"
# For Prisma with Supabase pooling, set DATABASE_URL to pooled and DIRECT_URL to direct (Prisma preview feature):
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.oaxvbtnjnfhldgbidaot.supabase.co:5432/postgres"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-a-very-long-random-string"

# Supabase API — keep these server-side where required, never commit real keys
NEXT_PUBLIC_SUPABASE_URL="https://oaxvbtnjnfhldgbidaot.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SUPABASE_SERVICE_ROLE_KEY]"

# Razorpay — https://dashboard.razorpay.com
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY="your_deepseek_api_key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# Vercel Blob — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token"

# Local fallback for storing uploaded files when Blob token is absent
LOCAL_UPLOAD_DIR=".uploads"

# Client-side Razorpay key (safe to expose in the browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Expose OTP codes in API responses (demo/dev only — disable in production)
OTP_EXPOSE_CODE=true
