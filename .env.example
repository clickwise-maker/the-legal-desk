DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legalflow"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-a-very-long-random-string"

# Razorpay — https://dashboard.razorpay.com
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY="your_deepseek_api_key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# Vercel Blob — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token"

# Local fallback for storing uploaded files when Blob token is absent
LOCAL_UPLOAD_DIR=".uploads"

# Client-side Razorpay key (safe to expose in the browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Expose OTP codes in API responses (demo/dev only — disable in production)
OTP_EXPOSE_CODE=true
