    "bcryptjs": "^2.4.3",
    "docx": "^9.7.1",
    "next": "^14.2.15",
    "next-auth": "^4.24.10",
    "next-themes": "^0.3.0",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
